# Required only for optional online LLM features. Never commit a real key.
OPENROUTER_API_KEY=

# Verified direct-API free model; keep the :free suffix.
OPENROUTER_MODEL=cohere/north-mini-code:free

# All optional features remain disabled by default.
ENABLE_LLM_NORMALIZE=false
ENABLE_LLM_OVERRIDE=false
ENABLE_LLM_MESSAGE=false
ENABLE_CONFIDENCE=false
